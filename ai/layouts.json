  "rules": {
    "titleMaxLines": 2,
    "referenceNumbering": "manual",
    "sourceMaxLines": 1,
    "notesMaxLines": 2,
    "rawHtml": "not supported in authored content",
    "itemCounting": "top-level list items only",
    "maximumBaseLayouts": 1,
    "highlightSyntax": "***重要な言葉***"
  },
  "resources": {
    "guide": "docs/AI_SLIDE_GUIDE.md",
