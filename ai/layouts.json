    },
    "diagram": {
      "requiresAny": [
        "media"
      ]
    },
    "ratio-1x1": {
      "exclusiveGroup": "ratio",
      "requiresAny": [
        "media",
        "figure"
      ]
    },
    "ratio-16x9": {
      "exclusiveGroup": "ratio",
      "requiresAny": [
        "media",
        "figure"
      ]
    },
    "ratio-4x3": {
      "exclusiveGroup": "ratio",
      "requiresAny": [
        "media",
        "figure"
      ]
    },
    "ratio-3x4": {
      "exclusiveGroup": "ratio",
      "requiresAny": [
