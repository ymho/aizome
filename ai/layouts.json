      ]
    },
    "fit-cover": {
      "exclusiveGroup": "fit",
      "requiresAny": [
        "media",
        "figure",
        "gallery"
      ]
    },
    "image-grid": {
      "requiresAny": [
        "gallery"
      ]
    },
    "detail-left": {
      "requiresAny": [
