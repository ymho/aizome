{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aizome layout contract",
  "type": "object",
  "required": ["schemaVersion", "theme", "version", "layouts", "modifiers", "deprecated", "rules", "resources"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "theme": {"const": "aizome"},
    "version": {"type": "string"},
    "description": {"type": "string"},
    "defaultLayout": {"$ref": "#/$defs/layout"},
    "layouts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/layout"}},
    "modifiers": {"type": "object", "additionalProperties": {
      "type": "object",
      "properties": {
        "exclusiveGroup": {"type": "string"},
        "requiresAny": {"type": "array", "items": {"type": "string"}},
        "conflicts": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }},
    "deprecated": {"type": "object", "additionalProperties": {"type": "string"}},
    "rules": {"type": "object"},
    "resources": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "additionalProperties": false,
  "$defs": {
    "layout": {
      "type": "object",
      "required": ["purpose", "structure"],
      "properties": {
        "purpose": {"type": "string"},
        "structure": {"type": "string"},
        "listType": {"enum": ["ordered", "unordered", "either"]},
        "recommendedMinItems": {"type": "integer", "minimum": 1},
        "recommendedMaxItems": {"type": "integer", "minimum": 1},
        "itemLayouts": {"type": "object", "additionalProperties": {"type": "string"}},
        "limitVariants": {"type": "array", "items": {
          "type": "object", "required": ["when", "min", "max"],
          "properties": {
            "when": {"type": "array", "items": {"type": "string"}},
            "min": {"type": "integer", "minimum": 1},
            "max": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        }}
      },
      "additionalProperties": false
    }
  }
}
